# Application
DEBUG=false
APP_NAME="Solo RPG Platform"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solo_rpg

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# PDF Storage
PDF_STORAGE_PATH=/home/orochford/rpgs

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_CHUNKS=7

# WebSocket
WS_PING_INTERVAL=25
WS_PING_TIMEOUT=120
